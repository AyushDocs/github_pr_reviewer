# Required
AI_API_KEY=your-nvidia-ai-endpoints-key
GITHUB_TOKEN=your-github-token

# LLM Configuration
AI_MODEL=google/gemma-2-2b-it
AI_EMBEDDING_MODEL=nvidia/nv-embed-v1
AI_TEMPERATURE=0.2
AI_TOP_P=1.0
AI_MAX_TOKENS=1024

# Fallback LLM (optional)
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=google/gemma-2-2b-it

# LangSmith Tracing (recommended)
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=pr-reviewer
LANGCHAIN_TRACING_V2=true

# PR Size Limits
PR_MAX_FILES=50
PR_MAX_PATCH_SIZE=500000

# LLM Concurrency & Truncation
MAX_CONCURRENT_LLM=5
MAX_DIFF_CHARS=15000

# Logging (DEBUG, INFO, WARNING, ERROR)
REVIEW_LOG_LEVEL=INFO

# SMTP Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-email@gmail.com
